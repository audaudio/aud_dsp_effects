{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "aud_dsp_effects",

  // 1-2 sentence summary about this repo.
  "summary": "Effect nodes of the Audanika Audio Engine on ABI 0.4: Freeverb, Dattorro plate, stereo and tempo delay (DunneAudioKit), look-ahead limiter, tremolo; plus a per-node render-time bench.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "Effect nodes aud.effects.{freeverb,plate,stereo_delay,tempo_delay,limiter,tremolo}: in place, variable blocks, ramped params, mono/stereo in, allocation in prepare only",
    "Vendored Freeverb (public domain) and DunneAudioKit StereoDelay (MIT, mix fixed); own plate (Dattorro 1997) and limiter (ceiling never exceeded, 1.5 ms latency); notices check",
    "AudEffectsBench (testing.dart): mean/p99/max render time per block of one node; goldens, native tests under ASan/UBSan, RTSan, TSan; link hook drops an unused library"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "aud_audio_core": "package dependency: C ABI 0.4 header, AudNodeBase, AudParamDescriptor",
      "aud_audio_graph": "dev dependency: engine of the native, golden and Dart tests",
      "aud_audio": "example/ dependency: AudEngine plays the chord through delay -> plate -> limiter"
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "apps": "master chain delay -> plate -> limiter via AudNativeNodePackage(AudDspEffects.name, AudDspEffects.register)"
    }
  }
}
